   "t": 498,
   "text": "じゃあどうしたのか"
  },
  {
   "t": 500,
   "text": "世界の広さを自慢するんじゃなくて"
  },
  {
   "t": 502,
   "text": "何もない場所を探して"
  },
  {
   "t": 504,
   "text": "そこに秘密とか"
  },
  {
   "t": 506,
   "text": "発見できるものを"
  },
  {
   "t": 508,
   "text": "一度的に加えてたんだ"
  },
  {
   "t": 509,
   "text": "ちょっと考えてみてほしいよ"
  },
  {
   "t": 511,
   "text": "素敵ですよ"
  },
  {
   "t": 513,
   "text": "ほんとにもうこの"
  },
  {
   "t": 515,
   "text": "これ良くないね"
  },
  {
   "t": 517,
   "text": "このゲーム大好きです"
  },
  {
   "t": 519,
   "text": "ということで"
  },
  {
   "t": 520,
   "text": "アメリカのゲームには作れない"
  },
  {
   "t": 522,
   "text": "もう一つの現実"
  },
  {
   "t": 524,
   "text": "もちろん商業的には"
  },
  {
   "t": 526,
   "text": "GTA6のほうが"
  },
  {
   "t": 527,
   "text": "はるかに大きな出来事になると思う"
  },
  {
   "t": 530,
   "text": "あの強大なオープンワールドには"
  },
  {
   "t": 532,
   "text": "想像もできなかったような可能性がある"
  },
  {
   "t": 535,
   "text": "でも30年近く経った今でも"
  },
  {
   "t": 538,
   "text": "時のオカリナは"
  },
  {
   "t": 539,
   "text": "技術の進歩だけでは"
  },
  {
   "t": 541,
   "text": "放射できない何かを示してる"
  },
  {
   "t": 544,
   "text": "僕の感覚では"
  },
  {
   "t": 545,
   "text": "GTAってさ"
  },
  {
   "t": 546,
   "text": "ほとんど何でできる強大な世界を"
  },
  {
   "t": 549,
   "text": "与えてくれるのかな"
  },
  {
   "t": 550,
   "text": "その一方"
  },
  {
   "t": 552,
   "text": "ゼルダは比較的に小さな世界を与えてくれるのに"
  },
  {
   "t": 556,
   "text": "それがいつの間にか"
  },
  {
   "t": 558,
   "text": "自分自身の一部になっている"
  },
  {
   "t": 560,
   "text": "子供の頃友達の家で"
  },
  {
   "t": 562,
   "text": "GTAとかアメリカのゲームを"
  },
  {
   "t": 564,
   "text": "遊んだこともある"
  },
  {
   "t": 565,
   "text": "ゲームの面白さのかなりの部分が"
  },
  {
   "t": 568,
   "text": "何をしてもいい"
  },
  {
   "t": 569,
   "text": "という自由にあったことだ"
  },
  {
   "t": 571,
   "text": "車を盗んだり"
  },
  {
   "t": 572,
   "text": "法律を破ったり"
  },
  {
   "t": 573,
   "text": "通行にを襲ったり"
  },
  {
   "t": 575,
   "text": "現実なら絶対許されないことができる"
  },
  {
   "t": 578,
   "text": "正直友達が"
  },
  {
   "t": 580,
   "text": "ゲームの中の暴力は"
  },
  {
   "t": 582,
   "text": "あんなに楽しんでるのを見て"
  },
  {
   "t": 584,
   "text": "少し言おこしの悪さを感じることもあった"
  },
  {
   "t": 587,
   "text": "そんな僕は家に帰ると"
  },
  {
   "t": 589,
   "text": "ゲームキューブを起動して"
  },
  {
   "t": 590,
   "text": "風のタクトのオーナバラへの船を出してた"
  },
  {
   "t": 594,
   "text": "水平さんの向こうに"
  },
  {
   "t": 595,
   "text": "何が待ってるのか"
  },
  {
   "t": 597,
   "text": "それを発見することが"
  },
  {
   "t": 599,
   "text": "僕にとってのワクワクだったんだ"
  },
  {
   "t": 601,
   "text": "まあもちろんね"
  },
  {
   "t": 602,
   "text": "GTAを楽しむこと実態が"
  },
  {
   "t": 605,
   "text": "悪いと言いたいわけじゃない"
  },
  {
   "t": 606,
   "text": "ただ僕自身は別のものに惹かれていた"
  },
  {
   "t": 609,
   "text": "ゼルダで僕が無知になったのは"
  },
  {
   "t": 612,
   "text": "好き勝手に何でもできる自由じゃない"
  },
  {
   "t": 614,
   "text": "誰かが想像して作り上げた世界を"
  },
  {
   "t": 617,
   "text": "自分の足で発見していくことだった"
  },
  {
   "t": 620,
   "text": "だからこそ今でも"
  },
  {
   "t": 621,
   "text": "ゼルダはGTAと肩を並べられるんじゃないかな"
  },
  {
   "t": 626,
   "text": "ロックスターは驚くほどリアルな世界を作れる"
  },
  {
   "t": 629,
   "text": "でもリアルであること"
  },
  {
   "t": 631,
   "text": "心に深く残ることは"
  },
  {
   "t": 633,
   "text": "全く別の達成なんだ"
  },
  {
   "t": 634,
   "text": "ここには"
  },
  {
   "t": 635,
   "text": "ゲーム作りにおける2つの異なる発想が"
  },
  {
   "t": 638,
   "text": "見えてくると思う"
  },
  {
   "t": 640,
   "text": "GTAは"
  },
  {
   "t": 641,
   "text": "僕たちの現実に似た正解を用意して"
  },
  {
   "t": 644,
   "text": "ここで何でも好きなことができるとしたら"
  },
  {
   "t": 647,
   "text": "と問いかける"
  },
  {
   "t": 647,
   "text": "一方ニンテンドは"
  },
  {
   "t": 649,
   "text": "現実とは全く違う世界を作り"
  },
  {
   "t": 652,
   "text": "この中に何があるか"
  },
  {
   "t": 653,
   "text": "探してみたくないと"
  },
  {
   "t": 655,
   "text": "問いかけることが多いんだ"
  },
  {
   "t": 656,
   "text": "そしてこれは"
  },
  {
   "t": 658,
   "text": "ゲームの面白さについて"
  },
  {
   "t": 660,
   "text": "大切なことを教えてくれる"
  },
  {
   "t": 662,
   "text": "優れたゲームかどうかは"
  },
  {
   "t": 664,
   "text": "与えられる自由の大きさだけでは決まらない"
  },
  {
   "t": 667,
   "text": "僕たちの注意とか"
  },
  {
   "t": 668,
   "text": "好奇心を"
  },
  {
   "t": 669,
   "text": "どれだけたくみに導けるかにも"
  },
  {
   "t": 672,
   "text": "かかっている"
  },
  {
   "t": 673,
   "text": "そこに宮本さんの天才性があると思う"
  },
  {
   "t": 676,
   "text": "無限にできることを与える必要なんてなかった"
  },
  {
   "t": 679,
   "text": "30年近くたった今でも"
  },
  {
   "t": 681,
   "text": "そこに暮らしてたような感覚を"
  },
  {
   "t": 684,
   "text": "思い出せるほど"
  },
  {
   "t": 685,
   "text": "丁寧に想像された世界を"
  },
  {
   "t": 687,
   "text": "与えてくれたんだ"
  },
  {
   "t": 688,
   "text": "だからこそ時のおかりなは"
  },
  {
   "t": 690,
   "text": "ずーっと僕の心に残って"
  },
  {
   "t": 693,
   "text": "もう一回言うんですけど"
  },
  {
   "t": 694,
   "text": "30年近く前日本のクリエイターたちは"
  },
  {
   "t": 697,
   "text": "小さなプラスチックのカセットに"
  },
  {
   "t": 700,
   "text": "収まる世界を作れ上げた"
  },
  {
   "t": 702,
   "text": "でもその世界は"
  },
  {
   "t": 703,
   "text": "僕の子供時代や"
  },
  {
   "t": 705,
   "text": "記憶の一部になり"
  },
  {
   "t": 706,
   "text": "やがて日本という国を"
  },
  {
   "t": 708,
   "text": "理解するきっかけにもなった"
  },
  {
   "t": 710,
   "text": "そして"
  },
  {
   "t": 711,
   "text": "アメリカのゲーム開発者にとっては"
  },
  {
   "t": 713,
   "text": "少し悔しい話かもしれないけど"
  },
  {
   "t": 716,
   "text": "ゲームを決策にするのに"
  },
  {
   "t": 718,
   "text": "派手な演出を"
  },
  {
   "t": 719,
   "text": "何もかも詰め込む必要はないんだと思う"
  },
  {
   "t": 722,
   "text": "必要なのは"
  },
  {
   "t": 723,
   "text": "人の心に残る芸術を作ろうとすること"
  },
  {
   "t": 726,
   "text": "そして"
  },
  {
   "t": 727,
   "text": "何より"
  },
  {
   "t": 728,
   "text": "大きな愛情なんじゃないかな"
  },
  {
   "t": 729,
   "text": "そこで冒頭の問いに戻りたい"
  },
  {
   "t": 732,
   "text": "実在しなかったはずの場所を"
  },
  {
   "t": 734,
   "text": "どうして僕は"
  },
  {
   "t": 735,
   "text": "こんなに懐かしく思うんだろう"
  },
  {
   "t": 737,
   "text": "確かに"
  },
  {
   "t": 738,
   "text": "ハエルアルは"
  },
  {
   "t": 739,
   "text": "真理的に実在しなかったのかもしれない"
  },
  {
   "t": 741,
   "text": "でも"
  },
  {
   "t": 742,
   "text": "そこで僕が作った思いでは"
  },
  {
   "t": 744,
   "text": "間違いなく"
  },
  {
   "t": 745,
   "text": "本物なんだ"
  },
  {
   "t": 746,
   "text": "はい"
  },
  {
   "t": 747,
   "text": "この動画が面白いって思ったら"
  },
  {
   "t": 749,
   "text": "チャンネル登録宜しくお願いします"
  },
  {
   "t": 751,
   "text": "時の遅れなやったことありますか"
  },
  {
   "t": 753,
   "text": "では"
  },
  {
   "t": 754,
   "text": "スクラウリーマーリー"
  },
  {
   "t": 756,
   "text": "チュシュシュシャー"
  }
 ]
}